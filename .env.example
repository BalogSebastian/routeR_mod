# ── routeR by tesotter ─────────────────────────────────────────────────────
# Másold .env.local néven és töltsd ki. A * jelölt változók kötelezők.

# * MongoDB (a tesotterdev klaszter is jó): külön adatbázis (ROUTER_DB_NAME), saját kollekciókkal.
ROUTER_MONGODB_URI=
ROUTER_DB_NAME=routeR
# * Munkamenet-süti titkosítása (iron-session), min. 32 karakter. Generálás: openssl rand -base64 48
ROUTER_SESSION_SECRET=
# Publikus URL (e-mailben lévő linkekhez) – https, soha nem localhost
SITE_URL=https://router-by-tesotter.vercel.app

# E-mail értesítések (opcionális): új regisztráció → admin, jóváhagyás → felhasználó (Gmail)
EMAIL_USER=
EMAIL_PASS=
ROUTER_ADMIN_NOTIFY=

# Routing-szerver (Valhalla)
VALHALLA_URL=https://valhalla1.openstreetmap.de
TRACE_CHUNK_KM=150
